{
  "openapi": "3.1.0",
  "info": {
    "title": "Item Management API",
    "version": "1.0.0",
    "description": "Generated API based on requirements: design a supermarket management api..."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/items": {
      "get": {
        "operationId": "get_items",
        "summary": "List all items",
        "description": "List all items",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of records to return",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of records to skip for pagination",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request / Validation Failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "operationId": "post_items",
        "summary": "Create a new item",
        "description": "Create a new item",
        "tags": [
          "Items"
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Resource created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request / Validation Failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Payload data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          }
        }
      }
    },
    "/items/{item_id}": {
      "get": {
        "operationId": "get_items_item_id",
        "summary": "Get item by ID",
        "description": "Get item by ID",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier for item_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request / Validation Failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "operationId": "delete_items_item_id",
        "summary": "Delete a item",
        "description": "Delete a item",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier for item_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Resource deleted successfully"
          },
          "400": {
            "description": "Bad Request / Validation Failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "detail",
          "status"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Human-readable error description",
            "example": "sample_detail"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 101
          },
          "code": {
            "type": "string",
            "description": "Error classification code",
            "example": "sample_code"
          }
        },
        "example": {
          "detail": "sample_detail",
          "status": 101,
          "code": "sample_code"
        }
      },
      "Item": {
        "type": "object",
        "description": "Represents a item record",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "title": {
            "type": "string",
            "example": "Sample title"
          },
          "status": {
            "type": "string",
            "example": "Sample status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T12:00:00Z"
          }
        },
        "example": {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "title": "Sample title",
          "status": "Sample status",
          "created_at": "2026-01-01T12:00:00Z"
        }
      },
      "ItemCreate": {
        "type": "object",
        "description": "Payload for creating a new Item",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Sample title"
          },
          "status": {
            "type": "string",
            "example": "Sample status"
          }
        },
        "example": {
          "title": "Sample title",
          "status": "Sample status"
        }
      },
      "ItemUpdate": {
        "type": "object",
        "description": "Payload for updating an existing Item",
        "properties": {
          "title": {
            "type": "string",
            "example": "Sample title"
          },
          "status": {
            "type": "string",
            "example": "Sample status"
          }
        },
        "example": {
          "title": "Sample title",
          "status": "Sample status"
        }
      },
      "ItemListResponse": {
        "type": "object",
        "description": "Paginated list of Item records",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "example": []
          },
          "total": {
            "type": "integer",
            "example": 100
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "offset": {
            "type": "integer",
            "example": 0
          }
        },
        "example": {
          "items": [],
          "total": 100,
          "limit": 20,
          "offset": 0
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT Bearer token"
      }
    }
  }
}